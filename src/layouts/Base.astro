---
import '@fontsource-variable/bricolage-grotesque/wght.css';
import '@fontsource-variable/dm-sans/wght.css';
import '@fontsource-variable/bodoni-moda/wght-italic.css';
import '@fontsource-variable/caveat/wght.css';
import '../styles/site.css';
import { profile } from '../data/portfolio.js';

const { title, description, path = Astro.url.pathname, schema } = Astro.props;
const canonical = new URL(path, Astro.site);
const socialImage = new URL('/media/social.jpg', Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ede7db" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" type="image/png" href="/media/mark.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Srivarsan K" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={socialImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Srivarsan K’s portfolio cover with a vermilion portrait cutout" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage.href} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema).replaceAll('<', '\\u003c')} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="shell">
      <header class="masthead">
        <a class="wordmark" href="/" aria-label="Srivarsan K home">sk<span>.</span></a>
        <nav aria-label="Main navigation">
          <a href="/#work">Work</a>
          <a href="/about.html">About</a>
          <a href="/#contact">Contact</a>
        </nav>
        <a class="desktop-link" href="/desktop/">Desktop mode <span aria-hidden="true">↗</span></a>
      </header>
      <slot />
      <footer class="footer">
        <span>Srivarsan K <span aria-hidden="true">/</span> Chennai, India</span>
        <div class="footer-links">
          <a rel="me" href={profile.github}>GitHub ↗</a>
          <a rel="me" href={profile.linkedin}>LinkedIn ↗</a>
        </div>
      </footer>
    </div>
  </body>
</html>
