---
import { socials } from '../data/portfolio.js';

// `buttons` renders round icon buttons that open into a pill with the handle on hover or focus;
// without it, plain text links in the style `linkClass` gives them.
const { linkClass, buttons = false } = Astro.props;
const icons = {
  GitHub: '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>',
  X: '<path d="M4 4l11.7 16H20L8.3 4z"/><path d="M4 20l6.8-6.8M20 4l-6.8 6.8"/>',
  LinkedIn: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>',
  Email: '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/>',
};
---
{buttons
  ? <div class="socials">
      {socials.map(([label, href, handle]) => (
        <a class="social" href={href} aria-label={label + ': ' + handle} rel={href.startsWith('mailto:') ? undefined : 'me'}>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" set:html={icons[label]} />
          <span class="social-text" aria-hidden="true"><span>{handle}</span></span>
        </a>
      ))}
    </div>
  : socials.map(([label, href]) => (
      <a class={linkClass} rel={href.startsWith('mailto:') ? undefined : 'me'} href={href}>{label} <span aria-hidden="true">↗</span></a>
    ))}
