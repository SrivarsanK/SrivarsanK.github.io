---
// Every screenshot is 1200x750 (16:10), captured from the project running locally, so the frame never crops it.
// `describe` exposes the alt text; cards leave it off because the link already names the project.
const { project, describe = false, eager = false } = Astro.props;

// Each print tears its own way: the tear is seeded from the slug, so it is stable from build to build.
let seed = [...project.slug].reduce((h, c) => Math.imul(h ^ c.charCodeAt(0), 16777619) >>> 0, 2166136261);
const rand = () => {
  seed = (seed + 0x6d2b79f5) | 0;
  let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};

// A torn outline in a 0-100 box: walk each edge, stepping inward by a slow drift plus a sharp fibre jag.
// Left and right edges are tear-scaled by 10/16 because one unit across a 16:10 print is wider there.
const tear = (inset, depth) => {
  const edges = [[0, 0, 100, 0, 0, 1, 1, 52], [100, 0, 100, 100, -1, 0, 0.625, 34], [100, 100, 0, 100, 0, -1, 1, 52], [0, 100, 0, 0, 1, 0, 0.625, 34]];
  let drift = depth / 2;
  return edges.flatMap(([x1, y1, x2, y2, nx, ny, scale, steps]) => Array.from({ length: steps }, (_, i) => {
    drift = Math.min(depth, Math.max(0, drift + (rand() - 0.5) * depth * 0.5));
    const d = (inset + drift + rand() * depth * 0.5) * scale;
    const x = x1 + ((x2 - x1) * i) / steps + nx * d;
    const y = y1 + ((y2 - y1) * i) / steps + ny * d;
    return x.toFixed(1) + ',' + y.toFixed(1);
  })).join(' ');
};
const mask = (points) => "url('data:image/svg+xml," + encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" preserveAspectRatio="none"><polygon points="${points}"/></svg>`) + "')";
// shortcut: the filter id is per slug, so one project shown twice on a page would share a warp; add a suffix prop if that ever happens.
const warpId = 'warp-' + project.slug;
---
<div class="shot" data-paper style={`--tear-paper:${mask(tear(0.2, 1.6))};--tear-print:${mask(tear(2.4, 2.8))};--warp:url(#${warpId})`}>
  <svg class="shot-warp" aria-hidden="true" focusable="false">
    <filter id={warpId} x="-6%" y="-6%" width="112%" height="112%" color-interpolation-filters="sRGB">
      <feImage href="/media/paper/warp.png" preserveAspectRatio="none" result="warp" />
      <feDisplacementMap in="SourceGraphic" in2="warp" scale="0" xChannelSelector="R" yChannelSelector="G" />
    </filter>
  </svg>
  <div class="shot-view">
    <img src={'/media/projects/' + project.slug + '.webp'} width="1200" height="750" alt={describe ? project.shot : ''} loading={eager ? 'eager' : 'lazy'} decoding="async" />
  </div>
</div>
