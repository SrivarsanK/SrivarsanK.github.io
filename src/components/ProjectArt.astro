---
// Every screenshot is 1200x750 (16:10), captured from the project running locally, so the frame never crops it.
// `describe` exposes the alt text; cards leave it off because the link already names the project.
const { project, describe = false, eager = false } = Astro.props;
---
<div class="shot">
  <div class="shot-view">
    <img src={'/media/projects/' + project.slug + '.webp'} width="1200" height="750" alt={describe ? project.shot : ''} loading={eager ? 'eager' : 'lazy'} decoding="async" />
  </div>
</div>
