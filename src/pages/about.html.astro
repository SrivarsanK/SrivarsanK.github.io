---
import Base from '../layouts/Base.astro';
import { profile } from '../data/portfolio.js';
---
<Base title="About Srivarsan K | Open-Source Developer & DSC Technical Lead" description="Meet Srivarsan K, an open-source AI and full-stack developer at SRMIST Ramapuram and Technical Lead at the Developer Students Club in Chennai." path="/about.html">
  <main id="main" class="detail">
    <a class="ink-link" href="/">← Home</a>
    <div class="detail-grid">
      <div>
        <p class="eyebrow">Chennai, India</p>
        <h1>About <strong>Srivarsan K.</strong></h1>
        <p class="lede">I’m an Artificial Intelligence student at SRM Institute of Science and Technology, Ramapuram, working on developer tools and applied AI.</p>
        <h2>What I build</h2>
        <p>I work across the stack, from <a href="/projects/glide/">Glide’s visual editing and source transformation</a> to <a href="/projects/nexus-solo/">Nexus Solo’s agent coordination</a> and <a href="/projects/urjabandhu/">UrjaBandhu’s appliance-level energy analytics</a>.</p>
        <h2>Developer Students Club</h2>
        <p>I’m a Technical Lead at DSC SRMIST Ramapuram. I coordinated Technorally 2.0 and co-organized DevSummit ’26, working with student teams, faculty, and speakers.</p>
        <div class="intro-links">
          <a class="ink-link" rel="me" href={profile.linkedin}>LinkedIn ↗</a>
          <a class="ink-link" rel="me" href={profile.github}>GitHub ↗</a>
          <a class="ink-link" href={'mailto:' + profile.email}>Email ↗</a>
        </div>
      </div>
      <img class="about-art" src="/media/srivarsan-hero-small.webp" width="460" height="575" alt="Portrait of Srivarsan K" decoding="async" />
    </div>
  </main>
</Base>
